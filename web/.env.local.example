# Copy to .env.local and fill in. See ../CLERK-SETUP.md for where these come from.

# Base URL of the FastAPI service (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Clerk — added when you wire @clerk/nextjs (Step 5 in CLERK-SETUP.md).
# The publishable key is public; the secret key is server-only (never NEXT_PUBLIC_).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
